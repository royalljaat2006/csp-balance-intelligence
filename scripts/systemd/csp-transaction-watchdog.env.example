# Settings for the transaction workbook watchdog (see scripts/watch_transaction_sheet.py).
# The app data directory: the SAME path as TRANSACTION_DATA_DIR_HOST in the project's .env.
TRANSACTION_DATA_DIR_HOST=/home/deepanshu/CSP_BALANCE_INTELLIGENCE/data
# The other team's folder with "Transaction Oct'26.xlsx" (read only).
TRANSACTION_SOURCE_DIR=/home/shumit/sbikisok
# How often to look, and how long the file must stay unchanged before it is copied (seconds).
TRANSACTION_WATCH_POLL_SECONDS=30
TRANSACTION_WATCH_SETTLE_SECONDS=45
# Safety re-sync of an unchanged file, in hours (0 = off). Ingest is idempotent.
TRANSACTION_WATCH_RESYNC_HOURS=6
# How long our own synced copies stay in processed/ (days).
TRANSACTION_SYNC_RETENTION_DAYS=14
