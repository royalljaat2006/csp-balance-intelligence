# Same watchdog as a USER-level service, for when sudo is not available. Runs as the logged-in user.
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/csp-transaction-watchdog.user.service ~/.config/systemd/user/csp-transaction-watchdog.service
#   cp scripts/systemd/csp-transaction-watchdog.env.example ~/.config/csp-transaction-watchdog.env
#   nano ~/.config/csp-transaction-watchdog.env
#   systemctl --user daemon-reload && systemctl --user enable --now csp-transaction-watchdog
#   # keep it running after logout / across reboots (try without sudo first):
#   loginctl enable-linger "$USER"
[Unit]
Description=CSP Balance Tracker - transaction workbook watchdog (read-only on the source)

[Service]
Type=simple
EnvironmentFile=%h/.config/csp-transaction-watchdog.env
ExecStart=/usr/bin/python3 %h/CSP_BALANCE_INTELLIGENCE/scripts/watch_transaction_sheet.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
