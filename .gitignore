# Local ingestion data — never real production files in git (Phase 10).
# Directory skeleton is kept via .gitkeep; contents are not.
data/incoming/*
data/processed/*
data/failed/*
!data/incoming/.gitkeep
!data/processed/.gitkeep
!data/failed/.gitkeep

# Server-side working data: bank statements hold customer names and account numbers, so they must
# never be committable; the rest is run-time state and logs.
data/bank_statements/
data/cs_backfill/
data/transaction_watchdog.json
dbt_run.log
txn_sync.log
txn_watchdog.log

# OS / editor
.DS_Store
Thumbs.db
