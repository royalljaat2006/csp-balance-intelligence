# Copy to .env and fill in real values. Never commit .env.

APP_NAME=csp-balance-tracker-app
# Assigned by the R730 administrator from the 8200-8299 (backend/API) range. See docs/DEPLOYMENT.md.
APP_PORT=CHANGE_ME
APP_ENV=production

# config.settings.development locally, config.settings.production in Docker
# (the Dockerfile sets this explicitly — you shouldn't normally need to).
DJANGO_SETTINGS_MODULE=config.settings.development

DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Required in production if the Django admin is reached over HTTPS through
# Nginx, e.g. https://csp-balance-tracker.developer.eko.co.in
DJANGO_CSRF_TRUSTED_ORIGINS=

# DATABASE_URL is what Django actually reads (django-environ). The
# DATABASE_* vars below feed the Postgres container in compose.yml and must
# match it.
DATABASE_URL=postgres://appuser:CHANGE_ME@db:5432/csp_balance_tracker
DATABASE_NAME=csp_balance_tracker
DATABASE_USER=appuser
DATABASE_PASSWORD=CHANGE_ME
# Persistent-connection reuse (production only, see config/settings/production.py).
DB_CONN_MAX_AGE=60
# Read-replica scaffold (see common/db_router.py) — leave blank until a real
# replica exists; "replica" then just aliases the same DB as DATABASE_URL.
DATABASE_REPLICA_URL=

# --- Redis (cache / rate limiting / agent queue) — scalability foundation, 2026-09-21 -----
# Blank -> LocMemCache + synchronous agent execution (today's exact
# behaviour, no Redis instance required). Set once `redis` (compose.yml) is
# running to enable dashboard-aggregate caching, API rate limiting shared
# across replicas, and async CSP Operations Agent dispatch.
REDIS_URL=redis://redis:6379/0
API_AUTH_THROTTLE_RATE=120/m
API_ANON_THROTTLE_RATE=20/m

# --- gunicorn (web tier) ----------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30

# --- Google Sheets (CALLING SHEET) — PRD §7.1 -------------------------------
# GOOGLE_SERVICE_ACCOUNT_FILE is the path *inside the container* — fixed, do
# not change. GOOGLE_SERVICE_ACCOUNT_FILE_HOST is where the key actually
# lives on the machine running docker compose; compose bind-mounts it
# read-only. The key must NEVER be copied into the image or the git repo —
# see docs/DEPLOYMENT.md "Secrets".
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
GOOGLE_SERVICE_ACCOUNT_FILE_HOST=CHANGE_ME
# The "Calling Sheet" spreadsheet's ID (from its URL) and the worksheet
# tab within it that has the CSP master + balance columns. Confirmed live:
# tab name is "Calling Sheet New"; change only if the sheet is restructured.
CALLING_SHEET_ID=CHANGE_ME
CALLING_SHEET_WORKSHEET_NAME=Calling Sheet New

# --- Transaction watched folder — PRD §7.2 (Option A), Phase 4/10 ----------
# TRANSACTION_DATA_DIR is the path *inside the container*; fixed. Its
# incoming/processed/failed subfolders are created automatically.
# TRANSACTION_DATA_DIR_HOST is the real folder on the host — production
# should point this at /opt/data/csp-balance-tracker (outside the git repo).
TRANSACTION_DATA_DIR=/data
TRANSACTION_DATA_DIR_HOST=./data

# --- API auth — PRD §8, Phase 8 -------------------------------------------
# No key lives here anymore. Issue one per consumer:
#   docker compose exec web python manage.py create_api_key dashboard --scopes csp:read,balance:read
# The raw key is printed once — copy it immediately, it is never shown again.
# Revoke with: manage.py revoke_api_key <key_prefix>

# --- Nemotron (autopilot app) — narration/prioritization, draft only -------
# Get a key from https://build.nvidia.com/. Leave blank to disable autopilot
# entirely — every generation function degrades to "produced nothing this
# run" without one (see autopilot/nemotron_client.py), the rest of the app
# is unaffected either way.
NEMOTRON_API_KEY=CHANGE_ME
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Telegram transaction-sheet ingestion (2026-09-18 platform extension) --
# Get a token from @BotFather. Leave blank to disable Telegram ingestion
# entirely — manage.py poll_telegram / watch_transactions's telegram
# schedule degrade to a no-op without one, same pattern as NEMOTRON_API_KEY.
# TELEGRAM_CHAT_ID is the ONLY chat the bot will accept a file from — send
# the bot a message from the intended chat, then read its chat_id via
# https://api.telegram.org/bot<token>/getUpdates. Mandatory once the token
# is set; without it, any chat that finds the bot could submit files.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
